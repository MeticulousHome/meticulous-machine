# The Dial (Qt Quick), straight on DRM/KMS: no Weston. The meticulous-dial package installs this same
# unit (its qt/packaging/meticulous-dial.service) over this copy; change both together.
[Unit]
Description=Meticulous Dial
After=network.target meticulous-backend.service systemd-user-sessions.service plymouth-quit-wait.service
# It must be the DRM master: never together with Weston.
Conflicts=weston.service
OnFailure=crash-reporter@.service

[Service]
ExecStart=/usr/bin/meticulous-dial-qt-launch
Restart=always
RestartSec=1
User=root
MemoryMax=1000M
Slice=meticulous.slice
Environment="XDG_RUNTIME_DIR=/run/user/0"

[Install]
WantedBy=multi-user.target
