#!/usr/bin/env python3
import argparse
import configparser
import fcntl
import json
import os
import platform
import re
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from datetime import datetime, timezone
from pathlib import Path

HAWKBIT_CONFIG = Path("/etc/hawkbit/config.conf")
HAWKBIT_CONFIG_GENERATOR = Path("/etc/hawkbit/create_config.sh")
HAWKBIT_CONFIG_LOCK = Path("/run/meticulous-hawkbit-config.lock")
HAWKBIT_ATTRIBUTE_CACHE = Path("/run/meticulous-hawkbit-attributes.json")
HAWKBIT_CHANNEL_FILE = Path("/etc/hawkbit/channel")
# The boot smoke result of this boot. On tmpfs, so it never outlives the boot
# it describes.
BOOT_ATTRIBUTE_CACHE = Path("/run/meticulous-boot-smoke-attributes.json")
BACKEND_URL = "http://127.0.0.1:8080/api/v1/smoke-validation"
MACHINE_INFO_URL = "http://127.0.0.1:8080/api/v1/machine"
HOSTNAME_FILE = Path("/etc/hostname")
DIAL_READY_MARKER = Path("/run/meticulous-dial-ready")
DIAL_HOME_READY_MARKER = Path("/run/meticulous-dial-home-ready")
VERSION_FILE = Path("/opt/image-build-version")
SENTRY_DIAL_BOOT_FAILURE_MARKER = Path("/run/meticulous-smoke-dial-sentry-reported")
# The self-hosted Sentry's meticulous-dial project, with the key the Dial
# reports with (its first key, 7d1372b7..., is disabled).
DEFAULT_DIAL_SENTRY_DSN = (
    "https://d958eb514629903cf133ad2b19e80ead@sentry.meticulousespresso.com/8"
)
# Sent with every event in place of an SDK's name: the script posts Sentry's
# envelope itself, so it runs on whichever python3 the image has (see
# send_sentry_event).
SENTRY_CLIENT = {"name": "meticulous-smoke-report", "version": "2"}
SENTRY_TIMEOUT = 10
DIAL_CHECKS = ("dial_service", "dial_ready", "dial_home_ready")
UNRESOLVED_PLACEHOLDER = re.compile(r"__[A-Z0-9_]+__")

# Marks a machine as reporting its own attributes. The server-side
# hawkbit-attribute-refresher is retired per channel once every online
# target in that channel carries this attribute, so it must be published
# on every run, even when deriving the rest of the set fails.
ATTRIBUTE_REPORTER = "push-v1"


def now():
    return datetime.now(timezone.utc).isoformat()


def read_text(path, default="unknown"):
    try:
        value = path.read_text(encoding="utf-8").strip()
        return value or default
    except Exception:
        return default


def bool_string(value):
    return "true" if value else "false"


def string_value(value):
    return "" if value is None else str(value)


def run(command, timeout=10):
    try:
        return subprocess.run(
            command,
            capture_output=True,
            text=True,
            timeout=timeout,
            check=False,
        )
    except Exception as exc:
        return subprocess.CompletedProcess(command, 1, "", str(exc))


def systemd_active(unit):
    return run(["systemctl", "is-active", "--quiet", unit]).returncode == 0


def read_json_url(url, timeout=5):
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def read_backend_status(timeout=5):
    return read_json_url(BACKEND_URL, timeout=timeout)


def read_machine_info(timeout=5):
    try:
        info = read_json_url(MACHINE_INFO_URL, timeout=timeout)
        info["identity_source"] = "backend_api"
        return info
    except Exception as api_exc:
        try:
            return read_machine_info_from_config(api_exc)
        except Exception as config_exc:
            return {
                "serial": "",
                "hostname": read_text(HOSTNAME_FILE, default=""),
                "name": "",
                "identity_source": "hostname_only",
                "backend_error": str(api_exc),
                "config_error": str(config_exc),
            }


def read_machine_info_from_config(api_error):
    # met-config reads the backend's settings file, as create_config.sh does
    # for the serial: the python3 this runs on may have no YAML parser.
    done = run(["met-config", "--json", "get", ".system"], timeout=10)
    if done.returncode != 0:
        raise RuntimeError(
            (done.stdout or done.stderr).strip()[-200:]
            or f"met-config exited {done.returncode}"
        )
    system = json.loads(done.stdout) or {}
    return {
        "serial": string_value(system.get("serial")),
        "hostname": read_text(HOSTNAME_FILE, default=""),
        "name": string_value(system.get("machine_name")),
        "identity_source": "config_file",
        "backend_error": str(api_error),
    }


def boot_checks():
    checks = {
        "backend_service": systemd_active("meticulous-backend.service"),
        "dial_service": systemd_active("meticulous-dial.service"),
        "dial_ready": DIAL_READY_MARKER.exists(),
        "dial_home_ready": DIAL_HOME_READY_MARKER.exists(),
        "backend_initialized": False,
        "esp32_responding": False,
    }
    backend_status = {}

    try:
        backend_status = read_backend_status()
        checks["backend_initialized"] = backend_status.get("backend_initialized") is True
        checks["esp32_responding"] = backend_status.get("esp32_responding") is True
    except Exception as exc:
        backend_status = {"error": str(exc)}

    return checks, backend_status


def wait_for_boot_checks(timeout):
    deadline = time.monotonic() + timeout
    checks = {}
    backend_status = {}
    while time.monotonic() <= deadline:
        checks, backend_status = boot_checks()
        if all(checks.values()):
            break
        time.sleep(3)
    return checks, backend_status


def make_boot_attributes(timeout):
    checks, backend_status = wait_for_boot_checks(timeout)
    failed = [name for name, passed in checks.items() if not passed]

    attributes = {
        "boot_smoke_status": "pass" if not failed else "fail",
        "boot_smoke_at": now(),
        "boot_smoke_version": read_text(VERSION_FILE),
        "boot_smoke_backend": bool_string(checks.get("backend_initialized")),
        "boot_smoke_dial": bool_string(
            checks.get("dial_service") and checks.get("dial_ready")
        ),
        "boot_smoke_dial_home": bool_string(checks.get("dial_home_ready")),
        "boot_smoke_esp32": bool_string(checks.get("esp32_responding")),
        "boot_smoke_failed_checks": ",".join(failed),
        "boot_smoke_machine_status": str(backend_status.get("machine_status", "")),
        "boot_smoke_firmware_version": str(backend_status.get("firmware_version", "")),
    }
    report_dial_boot_failure_to_sentry(checks, backend_status, attributes)
    return attributes


def store_boot_attributes(attributes):
    """Keep the boot smoke result so later publishes can send it again.

    The checks run once per boot, but their one publish can fail (no network
    yet, hawkBit unreachable), and hawkBit would then keep the result of an
    earlier boot. Every later run republishes this copy instead.
    """
    try:
        temp_path = BOOT_ATTRIBUTE_CACHE.with_name(BOOT_ATTRIBUTE_CACHE.name + ".tmp")
        temp_path.write_text(json.dumps(attributes, sort_keys=True), encoding="utf-8")
        temp_path.replace(BOOT_ATTRIBUTE_CACHE)
    except Exception as exc:
        print(f"Failed to write {BOOT_ATTRIBUTE_CACHE}: {exc}", file=sys.stderr)


def load_boot_attributes():
    """The boot smoke result of this boot, or nothing when the checks have not
    finished yet: the boot run is then still to publish it."""
    try:
        cached = json.loads(BOOT_ATTRIBUTE_CACHE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except Exception as exc:
        print(f"Failed to read {BOOT_ATTRIBUTE_CACHE}: {exc}", file=sys.stderr)
        return {}
    if not isinstance(cached, dict):
        return {}
    # Empty values are kept: an empty boot_smoke_failed_checks has to replace
    # the failed checks of an earlier boot.
    return {
        key: value
        for key, value in cached.items()
        if key.startswith("boot_smoke_") and isinstance(value, str)
    }


def make_device_attributes():
    """Device attributes previously published only by rauc-hawkbit-updater.

    Everything except update_channel is fixed for the lifetime of a boot, so it
    is derived once by create_config.sh and cached. update_channel is read live:
    the backend rewrites it whenever the user switches channel, and a boot-time
    copy would be stale exactly when it matters.
    """
    attributes = {"attribute_reporter": ATTRIBUTE_REPORTER}

    try:
        cached = json.loads(HAWKBIT_ATTRIBUTE_CACHE.read_text(encoding="utf-8"))
    except Exception as exc:
        print(f"Failed to read {HAWKBIT_ATTRIBUTE_CACHE}: {exc}", file=sys.stderr)
        cached = {}

    for key, value in cached.items():
        # Attributes are merged server-side, so an empty value would overwrite a
        # good one. Omitting the key leaves whatever hawkBit already holds.
        if isinstance(value, str) and value:
            attributes[key] = value

    channel = read_text(HAWKBIT_CHANNEL_FILE, default="")
    if channel:
        attributes["update_channel"] = channel

    return attributes


def make_shot_attributes():
    try:
        backend_status = read_backend_status()
    except Exception as exc:
        # These attributes are merged, not replaced. Falling back to "false"
        # here would clobber a real completion every time the backend happens to
        # be unreachable, which the hourly resync would then repeat forever.
        print(f"Skipping post-update shot attributes: {exc}", file=sys.stderr)
        return {}

    completed = backend_status.get("post_update_shot_completed") is True
    return {
        "post_update_shot_completed": bool_string(completed),
        "post_update_shot_completed_at": str(
            backend_status.get("post_update_shot_completed_at") or ""
        ),
        "post_update_shot_version": str(
            backend_status.get("post_update_shot_completed_version")
            or backend_status.get("image_version")
            or read_text(VERSION_FILE)
        ),
    }


def ensure_hawkbit_config():
    # The cache lives on tmpfs and is normally written by rauc-hawkbit-updater's
    # ExecStartPre, so it is absent whenever that unit failed or is masked while
    # config.conf survives from an earlier boot. The generator takes a lock, so
    # racing the updater is safe.
    if HAWKBIT_CONFIG.exists() and HAWKBIT_ATTRIBUTE_CACHE.exists():
        return
    if HAWKBIT_CONFIG_GENERATOR.exists():
        run(["bash", str(HAWKBIT_CONFIG_GENERATOR)], timeout=60)


def load_hawkbit_config():
    ensure_hawkbit_config()
    HAWKBIT_CONFIG_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with HAWKBIT_CONFIG_LOCK.open("a", encoding="utf-8") as lock_file:
        # create_config.sh holds an exclusive lock until its atomic rename and
        # attribute-cache publication are complete. A shared reader lock waits
        # for an active updater restart instead of reading its intermediate state.
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_SH)
        parser = configparser.ConfigParser()
        parser.read(HAWKBIT_CONFIG)
        client = parser["client"]

        scheme = "https" if client.getboolean("ssl", fallback=True) else "http"
        server = client.get("hawkbit_server")
        tenant = client.get("tenant_id", fallback="DEFAULT")
        target = client.get("target_name")
        ssl_verify = client.getboolean("ssl_verify", fallback=True)
        auth_token = client.get("auth_token", fallback="").strip()
        gateway_token = client.get("gateway_token", fallback="").strip()

    if not server or not target:
        raise RuntimeError("Hawkbit config is missing hawkbit_server or target_name")
    if any(
        UNRESOLVED_PLACEHOLDER.search(value)
        for value in (server, target, auth_token, gateway_token)
    ):
        raise RuntimeError("Hawkbit config contains an unresolved client placeholder")
    if not auth_token and not gateway_token:
        raise RuntimeError("Hawkbit config is missing auth_token/gateway_token")

    token_kind = "TargetToken" if auth_token else "GatewayToken"
    token = auth_token or gateway_token
    return scheme, server, tenant, target, ssl_verify, token_kind, token


def publish_attributes(attributes):
    scheme, server, tenant, target, ssl_verify, token_kind, token = load_hawkbit_config()
    quoted_target = urllib.parse.quote(target, safe="")
    url = f"{scheme}://{server}/{tenant}/controller/v1/{quoted_target}/configData"
    data = json.dumps({"mode": "merge", "data": attributes}).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=data,
        method="PUT",
        headers={
            "Authorization": f"{token_kind} {token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
    )

    context = None
    if scheme == "https" and not ssl_verify:
        import ssl

        context = ssl._create_unverified_context()

    with urllib.request.urlopen(request, timeout=30, context=context) as response:
        response.read()


def sentry_envelope_url(dsn):
    """The envelope endpoint and public key of a DSN,
    scheme://key@host[:port][/path]/project."""
    parts = urllib.parse.urlsplit(dsn)
    host = parts.netloc.rpartition("@")[2]
    path, _, project = parts.path.rstrip("/").rpartition("/")
    if parts.scheme not in ("http", "https") or not parts.username or not host or not project:
        raise ValueError("not a Sentry DSN")
    return f"{parts.scheme}://{host}{path}/api/{project}/envelope/", parts.username


def dial_boot_failure_event(checks, backend_status, attributes, machine_info):
    failed_dial_checks = [name for name in DIAL_CHECKS if checks.get(name) is False]
    tags = {
        "component": "meticulous-dial",
        "source": "meticulous-smoke-report",
        "image_version": attributes.get("boot_smoke_version", "unknown"),
        "machine_status": attributes.get("boot_smoke_machine_status", ""),
        "firmware_version": attributes.get("boot_smoke_firmware_version", ""),
        "serial": string_value(machine_info.get("serial")),
        "hostname": string_value(machine_info.get("hostname")),
        "machine_name": string_value(machine_info.get("name")),
        "machine_identity_source": string_value(machine_info.get("identity_source")),
        "dial_service_active": bool_string(checks.get("dial_service")),
        "dial_ready": bool_string(checks.get("dial_ready")),
        "dial_home_ready": bool_string(checks.get("dial_home_ready")),
        "backend_initialized": bool_string(checks.get("backend_initialized")),
        "esp32_responding": bool_string(checks.get("esp32_responding")),
    }
    return {
        "event_id": uuid.uuid4().hex,
        "timestamp": now(),
        "platform": "python",
        "level": "error",
        "logger": "meticulous-smoke-report",
        "environment": "production",
        "server_name": socket.gethostname(),
        "message": {
            "formatted": "Dial did not reach ready state during boot smoke validation"
        },
        "fingerprint": ["meticulous-smoke-report", "dial-boot-readiness-timeout"],
        # Sentry drops an empty tag value with an error on the event.
        "tags": {name: value for name, value in tags.items() if value},
        "contexts": {
            "runtime": {
                "name": platform.python_implementation(),
                "version": platform.python_version(),
            },
            "machine-info": machine_info,
            "boot-smoke-attributes": attributes,
            "boot-checks": checks,
            "backend-status": backend_status,
        },
        "extra": {"failed_dial_checks": failed_dial_checks},
        "sdk": SENTRY_CLIENT,
    }


def post_sentry_event(dsn, event):
    """Post an event to Sentry as an envelope, as the Qt Dial's ReportApi.qml
    does. Raises unless Sentry answers 2xx."""
    url, key = sentry_envelope_url(dsn)
    payload = json.dumps(event, default=str).encode("utf-8")
    envelope = b"\n".join(
        [
            json.dumps(
                {"event_id": event["event_id"], "sent_at": now(), "sdk": SENTRY_CLIENT}
            ).encode("utf-8"),
            json.dumps(
                {"type": "event", "length": len(payload), "content_type": "application/json"}
            ).encode("utf-8"),
            payload,
        ]
    ) + b"\n"
    client = f"{SENTRY_CLIENT['name']}/{SENTRY_CLIENT['version']}"
    request = urllib.request.Request(
        url,
        data=envelope,
        method="POST",
        headers={
            "Content-Type": "application/x-sentry-envelope",
            "X-Sentry-Auth": (
                f"Sentry sentry_version=7, sentry_key={key}, sentry_client={client}"
            ),
        },
    )
    with urllib.request.urlopen(request, timeout=SENTRY_TIMEOUT) as response:
        response.read()


def send_sentry_event(dsn, checks, backend_status, attributes, machine_info):
    """Send the event; its id once Sentry has accepted it.

    No Sentry SDK: the unit runs /opt/meticulous-venv/bin/python3, which is the
    Python backend's virtualenv on some images and the image's own python3 on
    others, so a package the script imports may simply not be there (it was
    sentry_sdk once). The event is all built here anyway, so the standard
    library is enough.
    """
    event = dial_boot_failure_event(checks, backend_status, attributes, machine_info)
    post_sentry_event(dsn, event)
    print(f"Reported dial boot smoke failure to Sentry with eventID: {event['event_id']}")
    return event["event_id"]


def report_dial_boot_failure_to_sentry(checks, backend_status, attributes):
    if not any(checks.get(name) is False for name in DIAL_CHECKS):
        return
    if SENTRY_DIAL_BOOT_FAILURE_MARKER.exists():
        return
    dsn = os.environ.get("METICULOUS_SMOKE_SENTRY_DSN", DEFAULT_DIAL_SENTRY_DSN).strip()
    if not dsn:
        return

    try:
        machine_info = read_machine_info()
        event_id = send_sentry_event(
            dsn, checks, backend_status, attributes, machine_info
        )
        SENTRY_DIAL_BOOT_FAILURE_MARKER.write_text(f"{event_id}\n", encoding="utf-8")
    except urllib.error.HTTPError as exc:
        with exc:
            body = exc.read().decode("utf-8", errors="replace")[:200]
        print(
            f"Failed to report dial boot smoke failure to Sentry: HTTP {exc.code} {body}",
            file=sys.stderr,
        )
    except Exception as exc:
        print(
            f"Failed to report dial boot smoke failure to Sentry: {exc}",
            file=sys.stderr,
        )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--boot", action="store_true", help="run boot smoke checks")
    parser.add_argument(
        "--shot",
        action="store_true",
        help="publish persisted post-update shot state without waiting for boot checks",
    )
    parser.add_argument(
        "--attributes",
        action="store_true",
        help="publish device attributes without waiting for boot checks",
    )
    parser.add_argument("--timeout", type=int, default=180)
    args = parser.parse_args()

    attributes = {}
    if args.boot or not (args.shot or args.attributes):
        attributes.update(make_boot_attributes(args.timeout))
        store_boot_attributes(attributes)
    else:
        # Evaluated once per boot, sent again on every later publish.
        attributes.update(load_boot_attributes())
    # Device attributes ride along on every publish: each one is a full
    # synchronisation, so a machine that reaches hawkBit at all reports a
    # complete, current set.
    attributes.update(make_device_attributes())
    attributes.update(make_shot_attributes())

    try:
        publish_attributes(attributes)
    except urllib.error.HTTPError as exc:
        print(
            f"Failed to publish smoke validation attributes: HTTP {exc.code}",
            file=sys.stderr,
        )
        print(exc.read().decode("utf-8", errors="replace"), file=sys.stderr)
        return 1
    except Exception as exc:
        print(f"Failed to publish smoke validation attributes: {exc}", file=sys.stderr)
        return 1

    print(json.dumps(attributes, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
