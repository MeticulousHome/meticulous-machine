server {
	listen 80 default_server;
	listen [::]:80 default_server;

	# SSL configuration
	#
	listen 443 ssl default_server;
	listen [::]:443 ssl default_server;
	#
	# Note: You should disable gzip for SSL traffic.
	# See: https://bugs.debian.org/773332
	#
	# Read up on ssl_ciphers to ensure a secure configuration.
	# See: https://bugs.debian.org/765782
	#
	# Self signed certs generated by the ssl-cert package
	# Don't use them in a production server!
	#
	include snippets/snakeoil.conf;

	root /opt/meticulous-web-app;

	# Add index.php to the list if you are using PHP
	index index.html index.htm index.nginx-debian.html;

	server_name _;

	location / {
		root /opt/meticulous-web-app;
		autoindex on;
		try_files $uri $uri/ =404;
	}

	location /debug {
		alias /opt/meticulous-backend/api/web_ui;
		autoindex on;
		index graph.html;
                try_files $uri $uri/ =404;
	}

	location /debug/plotter-ui {
		alias /opt/meticulous-plotter-ui/;
		autoindex on;
		try_files $uri $uri/ =404;
	}

    # Combined proxy pass for /socket.io and /api
    location ~ ^/(socket\.io|api) {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 1800s;

        # Allow JSON compression for proxied API responses
        gzip on;
        gzip_proxied any;
        gzip_types application/json;
        gzip_min_length 1000;  # skip tiny responses
    }

	# Device authorization for the watcher. nginx asks the backend whether
	# this request may continue, using the same rule as /api: the machine
	# itself is exempt and every other client needs a Bearer token. /api and
	# /socket.io are not gated here because the backend enforces it itself.
	location = /_device_auth {
		internal;
		proxy_pass http://127.0.0.1:8080/api/v1/auth/validate;
		proxy_method GET;
		proxy_pass_request_body off;
		proxy_set_header Content-Length "";
		proxy_set_header Host $host;
		proxy_set_header Authorization $http_authorization;
		# Required: without it the backend sees no X-Real-IP (which it treats
		# as the machine itself) or whatever X-Real-IP the client sent.
		proxy_set_header X-Real-IP $remote_addr;
		# Fail fast so a stuck backend does not hang diagnostics requests.
		proxy_connect_timeout 2s;
		proxy_send_timeout 5s;
		proxy_read_timeout 5s;
	}

	# Same body as the backend's own 401, so clients can tell they need pairing.
	location @device_unauthorized {
		default_type application/json;
		add_header WWW-Authenticate Bearer always;
		add_header Cache-Control "no-store" always;
		return 401 '{"status":"error","error":"This device is not authorized","data":{"code":"UNAUTHORIZED"}}';
	}

	# The watcher serves logs and the shot history archive, so it needs a token.
	# Loopback callers (the backend's bug reports, the image checks) pass the
	# access rules without asking the backend, so they keep working while it
	# restarts.
	location ~* ^/health {
		satisfy any;
		allow 127.0.0.0/8;
		allow ::1;
		deny all;
		auth_request /_device_auth;
		error_page 401 = @device_unauthorized;

		rewrite ^/health/(.*) /$1 break;
		proxy_pass http://127.0.0.1:3000;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_read_timeout 1800s;
	}
}
